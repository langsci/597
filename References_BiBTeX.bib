	copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
	issn = {1360-6441, 1467-9841},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/1467-9481.00163},
	doi = {10.1111/1467-9481.00163},
	abstract = {This paper explores the effects of the standard language ideology on attitudes to language of nonlinguists and of language specialists, and considers how far linguists themselves have been affected by – and have contributed to – this ideology. The primary definition of standardization is taken to be
              the imposition of uniformity upon a class of objects
              . Attitudes to language within
              standard language cultures
              are then reviewed and contrasted with unstandardized situations, in which the boundaries of languages are indeterminate. It is therefore suggested that determinate languages, such as English, may be defined more by ideologies than by their internal structures. Some effects of standardization on the work of linguists are then reviewed. This is followed by a discussion of the importance of the process of legitimization in contributing to the standard language culture, and of the contribution of language specialists themselves to this process. Finally, certain matters arising are reviewed.},
