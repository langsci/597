@article{antonova-unlu_syntaxpragmatic_2019,
	title = {Syntax–pragmatic and morphology–pragmatic interfaces in sequential bilingual language acquisition: {The} case of {Russia}-{Turkish} and {English}-{Turkish} bilingual children},
	volume = {23},
	issn = {1367-0069, 1756-6878},
	shorttitle = {Syntax–pragmatic and morphology–pragmatic interfaces in sequential bilingual language acquisition},
	url = {http://journals.sagepub.com/doi/10.1177/1367006918781065},
	doi = {10.1177/1367006918781065},
	abstract = {Aims:
              This study examines sequential bilingual language development focusing on the acquisition of two domains that interact with pragmatics, precisely, post-predicate constituents and case marking for direct objects in Turkish, which are cases of syntax–pragmatic and morphology–pragmatic interface, respectively, by Russian-Turkish and English-Turkish sequential bilinguals who had been acquiring Turkish as their child second language (cL2).
            
            
              Design:
              A cross-sectional design was adopted in the study.
            
            
              Methods:
              Narratives were used as a method of data collection. The use of post-predicate constituents and case markers for direct objects produced by the sequential bilinguals in their cL2 Turkish was compared with that of Turkish monolingual and simultaneous bilingual children.
            
            
              Conclusions:
              The study provides evidence that cL2 may be similar to monolingual and bilingual first language acquisition in some domains, while the other domains may be affected by age of onset and cross-linguistic influence from the other language that has developed to a certain extent.},
	language = {en},
	number = {5},
	urldate = {2023-12-11},
	journal = {International Journal of Bilingualism},
	author = {Antonova-Ünlü, Elena},
	month = oct,
	year = {2019},
	pages = {1137--1158},
}

